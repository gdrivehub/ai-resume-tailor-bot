# =====================================================================
# AI RESUME TAILOR BOT - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real ".env" file to GitHub.
# =====================================================================

# ---------------------------------------------------------------------
# TELEGRAM API CREDENTIALS
# Get API_ID and API_HASH from https://my.telegram.org -> API Development Tools
# Get BOT_TOKEN from https://t.me/BotFather
# ---------------------------------------------------------------------
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_here

# ---------------------------------------------------------------------
# ADMIN CONFIGURATION
# Comma-separated list of Telegram numeric user IDs who get admin access.
# Get your numeric ID by messaging @userinfobot on Telegram.
# ---------------------------------------------------------------------
ADMINS=123456789,987654321

# ---------------------------------------------------------------------
# DUMP CHANNEL
# Create a PRIVATE Telegram channel, add your bot as an ADMIN with
# "Post Messages" permission, then put the channel's numeric ID here.
# Channel IDs look like: -1001234567890
# (Forward a message from the channel to @JsonDumpBot or @userinfobot
#  to find the ID, or use /getchannelid inside the bot after adding it
#  as admin and running the setup command described in the README.)
# ---------------------------------------------------------------------
DUMP_CHANNEL_ID=-1001234567890

# ---------------------------------------------------------------------
# MONGODB
# Free tier: https://www.mongodb.com/cloud/atlas/register
# ---------------------------------------------------------------------
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=resume_tailor_bot

# ---------------------------------------------------------------------
# AI PROVIDERS
# GEMINI is used first if GEMINI_API_KEY is set (non-empty).
# If GEMINI_API_KEY is blank/missing, the bot automatically falls back
# to OPENROUTER_API_KEY for every AI call. If both are set, Gemini is
# tried first and OpenRouter is used only if Gemini fails/rate-limits.
#
# Get a free Gemini key:      https://aistudio.google.com/app/apikey
# Get a free OpenRouter key:  https://openrouter.ai/keys
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
# openrouter/free is OpenRouter's own auto-router: it always resolves to
# WHATEVER free model is currently live, so it doesn't go stale the way a
# hardcoded model slug does (OpenRouter's free-tier lineup rotates often —
# models get added/renamed/retired with little notice). This is the
# recommended default. The two fallbacks below are individually-named
# free models verified live as of July 2026, used only if the router
# itself is unreachable.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free
# If you prefer to pin a specific model instead of the auto-router, check
# https://openrouter.ai/models?fmt=cards&order=pricing-low-to-high for the
# current live free-tier list before setting OPENROUTER_MODEL manually.

# ---------------------------------------------------------------------
# BOT BEHAVIOUR
# ---------------------------------------------------------------------
# Max resumes/JDs stored per user
MAX_RESUMES_PER_USER=10
MAX_JDS_PER_USER=10

# Rate limiting (requests per user per window, in seconds)
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=60

# Max file size accepted for resume uploads (in MB)
MAX_FILE_SIZE_MB=10

# Enable/disable duplicate detection cache (true/false)
ENABLE_DUPLICATE_CACHE=true

# Bot working directory for temp files (auto-created)
TEMP_DIR=./temp

# Directory where the Telegram session file is persisted (auto-created).
# IMPORTANT: keep this on a persistent volume in Docker. Losing/recreating
# this file forces a fresh Telegram login on every restart, and doing that
# too many times in a short window triggers Telegram's FloodWait lockout.
SESSION_DIR=./sessions

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of Pyrogram worker threads (tune for your VPS CPU cores)
WORKERS=4

# ---------------------------------------------------------------------
# WEB HEALTH-CHECK SERVER (required by Koyeb / Render free web services)
# ---------------------------------------------------------------------
ENABLE_HEALTH_SERVER=true
HEALTH_SERVER_PORT=8080
